# Copie este arquivo para ".env" (na mesma pasta) e ajuste. Todas as linhas são opcionais.
# Linhas começando com # são ignoradas.

# Profile do AWS CLI a usar (o nome que você deu em "aws configure --profile NOME").
# Em branco: usa AWS_PROFILE ou o profile "default" / credenciais padrão da máquina.
MONITOR_AWS_PROFILE=

# Região onde estão seus logs (ex.: us-east-1, sa-east-1). Em branco: a região do profile.
MONITOR_AWS_REGION=

# Nome exibido no painel e no relatório PNG.
MONITOR_APP_NAME=CloudWatch Monitor

# Nome do sistema/empresa citado nos prompts gerados para o Claude (ex.: "Loja XPTO").
MONITOR_SYSTEM_NAME=

# Porta do painel local (http://127.0.0.1:PORTA/).
MONITOR_PORT=8765

# Caminho do banco SQLite. Em branco: pasta de dados do usuário (veja o README).
MONITOR_DB=
